# Copy to .env.local and fill in. .env* is gitignored. Never commit real values.
#
# The contact form posts to /api/contact, which sends through this mailbox.
# Office 365 wants port 587 with STARTTLS, which is SMTP_SECURE=false.
# Note: Microsoft disables SMTP AUTH per-mailbox by default on most M365
# tenants. If sending fails with "535 5.7.139 Authentication unsuccessful",
# it must be enabled for this mailbox in the admin centre.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where contact-form submissions are delivered.
CONTACT_TO=

# Canonical origin for metadata, sitemap, robots and JSON-LD. Defaults to
# https://www.sgmdoctor.com when unset.
NEXT_PUBLIC_SITE_URL=
